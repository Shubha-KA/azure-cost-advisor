# Copy to terraform.tfvars and customize before: terraform apply

project_name = "cost-advisor"
location     = "eastus"
environment  = "prod"

# VM Scale Set
vmss_vm_size       = "Standard_B2s"
vm_admin_username  = "azureuser"
vm_admin_password  = "ChangeMe!2026#"   # min 12 chars — use TF_VAR_ in CI/CD
vmss_min_instances = 1
vmss_max_instances = 3
streamlit_port     = 8501

# Application Gateway
app_gateway_sku      = "WAF_v2"
app_gateway_capacity = 2

# Secrets — pass via environment in CI/CD instead of committing:
# export TF_VAR_azure_openai_api_key="your-key"
# export TF_VAR_azure_openai_endpoint="https://your-resource.services.ai.azure.com/"
azure_openai_endpoint             = ""
azure_openai_api_key              = ""
azure_openai_api_version          = "2024-08-01-preview"
azure_openai_deployment_name      = "gpt-4o"
azure_openai_embedding_deployment = "text-embedding-3-small"
